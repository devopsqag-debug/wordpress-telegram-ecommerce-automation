APP_NAME="TeleShop Connector"
APP_ENV=production
APP_KEY=base64:7rM92KjWnF83qLzV8h0o7m0p+6e4f3a2b1c0d9e8f7g=
APP_DEBUG=false
APP_URL=https://teleshop.flotraq.dev

LOG_CHANNEL=stack
LOG_LEVEL=info

# Database (PostgreSQL / MySQL for Laravel Standalone)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=teleshop_production
DB_USERNAME=teleshop_user
DB_PASSWORD=secret_db_password

# Redis & Queues for High-Speed Webhooks
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Centralized Stripe Connect Marketplace (Platform credentials)
STRIPE_SECRET_KEY=sk_live_platform_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_platform_pub_key
STRIPE_WEBHOOK_SECRET=whsec_platform_signing_secret
STRIPE_CONNECT_CLIENT_ID=ca_flotraq_stripe_connect_client_id

# Marketplace Commission Settings
PLATFORM_COMMISSION_BPS=500
PLATFORM_FIXED_FEE_CENTS=30
PLATFORM_HOLDING_PERIOD_BUSINESS_DAYS=3

# Cloudflare Worker & Telegram Webhook Edge
CLOUDFLARE_CUSTOM_DOMAIN=https://wpgram.flotraq.com
CLOUDFLARE_WORKER_URL=https://wpgram.flotraq.com
CLOUDFLARE_PAGES_URL=https://wpgram.flotraq.com
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_WEBHOOK_SECRET=flotraq_secure_tg_webhook_secret_key

# Agency Identification
