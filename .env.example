# ==============================================================================
# TELESHOP CONNECTOR - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Core Application & Server Settings
PORT=3000
APP_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# Cloudflare Worker & Pages Custom Domain
CLOUDFLARE_CUSTOM_DOMAIN="wpgram.flotraq.com"
CLOUDFLARE_PAGES_PROJECT="teleshop-wp-demo"
CLOUDFLARE_WORKER_NAME="teleshop-connector-edge"

# AI Studio Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Master Encryption Key for AES-256-GCM Credential Storage at Rest (Benefit 33)
ENCRYPTION_MASTER_KEY="teleshop_production_master_secret_32bytes_min_key_aes256"

# Centralized Stripe Connect Marketplace Settings
STRIPE_SECRET_KEY="sk_test_placeholder_platform_key"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_platform_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_webhook_signing_secret"
STRIPE_CONNECT_CLIENT_ID="ca_placeholder_stripe_connect_client_id"

# Platform Marketplace Fee Settings
PLATFORM_COMMISSION_BPS=500
PLATFORM_FIXED_FEE_CENTS=30
PLATFORM_HOLDING_PERIOD_BUSINESS_DAYS=3

# Firebase Firestore & Authentication Configuration
FIREBASE_PROJECT_ID="teleshop-connector-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@teleshop-connector-prod.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Telegram Bot API Configuration (Benefit 18, 29, 30)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_placeholder"
TELEGRAM_BOT_USERNAME="teleshop_demo_bot"
TELEGRAM_RATE_LIMIT_GLOBAL_MSG_PER_SEC=30

# E-commerce Platform Adapters (Benefit 32)
SHOPIFY_STORE_DOMAIN="artisan-goods-demo.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN="shpat_demo_storefront_access_token_123"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_demo_admin_access_token_456"

WOOCOMMERCE_SITE_URL="https://demo-woocommerce-store.example.com"
WOOCOMMERCE_CONSUMER_KEY="ck_demo_consumer_key_789"
WOOCOMMERCE_CONSUMER_SECRET="cs_demo_consumer_secret_012"
